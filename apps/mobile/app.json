{
  "expo": {
    "name": "자격증봄",
    "slug": "certbom",
    "version": "0.9.1",
    "description": "자격증 공식 일정·D-Day·로컬 알림·준비 체크리스트를 한곳에서 관리하는 자격증봄",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "certbom",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "kr.robom.certbom",
      "buildNumber": "13",
      "supportsTablet": true,
      "associatedDomains": []
    },
    "android": {
      "package": "kr.robom.certbom",
      "versionCode": 17,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E7F4EB"
      },
      "intentFilters": []
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#18794e",
          "defaultChannel": "certbom-reminders-v2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "robom-labs",
    "extra": {
      "eas": {
        "projectId": "a9e8c88b-638b-4bf6-881b-539a12915421"
      }
    }
  }
}
